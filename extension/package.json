{
  "name": "shareguard-extension",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chromium": "node scripts/build.mjs chromium",
    "build:firefox": "node scripts/build.mjs firefox",
    "dev": "node scripts/build.mjs --watch",
    "dev:chromium": "node scripts/build.mjs chromium --watch",
    "dev:firefox": "node scripts/build.mjs firefox --watch",
    "firefox": "npm run build:firefox && web-ext run --source-dir dist/firefox",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "test": "node --experimental-strip-types --test test/display-media-contract.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "web-ext": "^10.7.0"
  }
}
